{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-ap",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "fb45e83a-f047-4021-9566-5c9382f6326b","database_name": "web-ap" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "490defc4695049a1b7a4175fdffee4cb" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
